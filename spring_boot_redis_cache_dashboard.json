{
  "title": "Spring Boot Redis Cache",
  "uid": "spring-redis-cache",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": [
    "spring-boot",
    "redis",
    "cache",
    "micrometer"
  ],
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "label": "Prometheus"
      },
      {
        "name": "cache",
        "type": "query",
        "label": "Cache",
        "query": "label_values(cache_gets_total, cache)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "users",
          "value": "users"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Cache Hit Rate",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "100 * sum(rate(cache_gets_total{cache=~\"$cache\",result=\"hit\"}[$__rate_interval])) / clamp_min(sum(rate(cache_gets_total{cache=~\"$cache\"}[$__rate_interval])), 0.000001)",
          "legendFormat": "Hit %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "colorMode": "value"
      }
    },
    {
      "id": 2,
      "title": "Cache Hits / sec",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(rate(cache_gets_total{cache=~\"$cache\",result=\"hit\"}[$__rate_interval]))",
          "legendFormat": "hits/s",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "colorMode": "value"
      }
    },
    {
      "id": 3,
      "title": "Cache Misses / sec",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(rate(cache_gets_total{cache=~\"$cache\",result=\"miss\"}[$__rate_interval]))",
          "legendFormat": "misses/s",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "colorMode": "value"
      }
    },
    {
      "id": 4,
      "title": "Cache Puts / sec",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(rate(cache_puts_total{cache=~\"$cache\"}[$__rate_interval]))",
          "legendFormat": "puts/s",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "colorMode": "value"
      }
    },
    {
      "id": 5,
      "title": "Cache Hits vs Misses",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(rate(cache_gets_total{cache=~\"$cache\",result=\"hit\"}[$__rate_interval]))",
          "legendFormat": "Hits/s",
          "refId": "A"
        },
        {
          "expr": "sum(rate(cache_gets_total{cache=~\"$cache\",result=\"miss\"}[$__rate_interval]))",
          "legendFormat": "Misses/s",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "title": "Cache Puts vs Evictions",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(rate(cache_puts_total{cache=~\"$cache\"}[$__rate_interval]))",
          "legendFormat": "Puts/s",
          "refId": "A"
        },
        {
          "expr": "sum(rate(cache_evictions_total{cache=~\"$cache\"}[$__rate_interval]))",
          "legendFormat": "Evictions/s",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    }
  ]
}